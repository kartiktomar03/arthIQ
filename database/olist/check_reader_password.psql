\set ON_ERROR_STOP on
SELECT rolpassword IS NULL AS needs_password FROM pg_catalog.pg_authid
WHERE rolname='arthiq_olist_analytics' \gset
\if :needs_password
\echo Set a new password for the existing Olist reader. Enter it again at the verifier prompt.
\password arthiq_olist_analytics
\else
\echo The reader already has a password. Use the existing reader password at the verifier prompt.
\endif
