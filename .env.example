# Copy to .env in the project root. Set the required connection and Groq values locally.
ANALYTICS_DSN=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
QUERY_TIMEOUT_MS=3000
MAX_ROWS=200
MAX_RESPONSE_BYTES=262144
SCHEMA_MODE=rag
SCHEMA_TOP_K=4
SCHEMA_MIN_SIMILARITY=0.43
SCHEMA_DATASOURCE_ID=demo-shop
EMBEDDING_LOCAL_FILES_ONLY=false
# QDRANT_PATH defaults to .qdrant in the project root.
WORKSPACE_DSN=

# Optional existing read-only Olist login on 127.0.0.1:5432/arthiq_olist. Omit when unused.
# OLIST_ANALYTICS_DSN=
